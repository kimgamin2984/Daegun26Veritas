import pandas as pd

# [중요] 1단계에서 확인한 본인의 구글 시트 ID를 아래 따옴표 안에 넣어주세요!
# 예시 ID 대신 실제 본인의 시트 ID를 입력하셔야 합니다.
SHEET_ID = "1T3RNtiowSwmIWUIRBAWqWQObZkJB8z9yxYy-iuZct-g" 

# 구글 시트를 CSV 다운로드 링크 형태로 변환하는 주소입니다.
sheet_url = f"https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv"

print("🔄 구글 시트에서 공공데이터를 원격으로 불러오는 중입니다...")

try:
    # URL을 통해 구글 시트 데이터를 바로 Pandas 데이터프레임으로 읽어옵니다.
    # 한글 깨짐이 발생하면 encoding='cp949' 또는 encoding='utf-8'을 시도해보세요.
    df = pd.read_csv(sheet_url, encoding='utf-8')
    
    print("✅ 데이터 로드 성공!")
    print("\n📊 [데이터의 처음 5개 행 미리보기]")
    print(df.head())
    
    print("\nℹ️ [데이터 기본 정보]")
    print(df.info())
    
    # --------------------------------------------------
    # 여기에 원하는 전처리 코드를 추가하시면 됩니다.
    # (예: 결측치 제거, 데이터 타입 변경 등)
    # --------------------------------------------------
    
    # 전처리가 끝난 데이터를 코드스페이스에 파일로 저장합니다.
    output_file = "공공데이터_전처리완료.csv"
    df.to_csv(output_file, index=False, encoding='utf-8-sig')
    print(f"\n🎉 전처리된 데이터가 '{output_file}' 파일로 저장되었습니다.")

except Exception as e:
    print(f"❌ 에러가 발생했습니다. 시트 ID와 공유 설정을 다시 확인해주세요.\n에러 내용: {e}")